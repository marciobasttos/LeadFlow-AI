    {
      "parameters": {
        "jsCode": "// Dados antigos (vindos do SELECT)\nconst antigo = $input.first().json;\n\n// Dados novos (vindos do Webhook)\nconst novo = $('Webhook').first().json.body;\n\n// Lista de alterações\nlet alteracoes = [];\n\n// Verifica alteração no nome\nif (antigo.nome != novo.nome) {\n    alteracoes.push({\n        lead_id: antigo.id,\n        campo_alterado: \"nome\",\n        valor_antigo: antigo.nome,\n        valor_novo: novo.nome\n    });\n}\n\n// Verifica alteração no telefone\nif (antigo.telefone != novo.telefone) {\n    alteracoes.push({\n        lead_id: antigo.id,\n        campo_alterado: \"telefone\",\n        valor_antigo: antigo.telefone,\n        valor_novo: novo.telefone\n    });\n}\n\n// Retorna no formato esperado pelo n8n\nreturn alteracoes.map(alteracao => ({\n    json: alteracao\n}));"
      },
      "type": "n8n-nodes-base.code",
